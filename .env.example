# Optional overrides for `docker compose up`. Copy to `.env` (never commit it).
# Defaults are shown. The full list of backend settings is in backend/.env.example.
DECISION_CUTOFF_TIME=09:00
DECISION_TIMEZONE=Europe/London
DECISION_DAYS_AHEAD=1
FORECAST_RESOLUTION_MINUTES=60
MAPE_MIN_ACTUAL_MW=50
LOG_LEVEL=INFO
