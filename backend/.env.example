# Elexon Insights (BMRS) API. No API key is required for these public endpoints.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# --- Business rule: which forecast counts as "available at decision time" ---
# For delivery day D, the decision is assumed to be taken on (D - DECISION_DAYS_AHEAD)
# at DECISION_CUTOFF_TIME in DECISION_TIMEZONE. The forecast used for a half-hour is the
# one with the latest publishTime at or before that cutoff. This is an ASSUMPTION
# (the assignment gives no exact gate-closure time). Change it here, nothing else needed.
DECISION_CUTOFF_TIME=09:00
DECISION_TIMEZONE=Europe/London
DECISION_DAYS_AHEAD=1

# --- Scope: delivery days whose purchase decision is taken in January 2026 ---
# Decisions for delivery on 2 Jan .. 1 Feb 2026 are taken on 1 Jan .. 31 Jan 2026.
DELIVERY_WINDOW_START=2026-01-02
DELIVERY_WINDOW_END=2026-02-01

# --- Forecast grid ---
# WINDFOR target timestamps are on the hour (verified on live Elexon data, Jan 2026) while FUELHH
# actuals are every 30 minutes. This defines the EXPECTED forecast grid used for coverage only.
# Pairs are always formed by exact startTime match; nothing is interpolated or averaged.
FORECAST_RESOLUTION_MINUTES=60

# --- Fetching / resilience ---
FORECAST_PUBLISH_LOOKBACK_DAYS=3
REQUEST_CHUNK_DAYS=3
REQUEST_TIMEOUT_SECONDS=30
REQUEST_MAX_RETRIES=3
REQUEST_BACKOFF_SECONDS=0.5
MAX_CONCURRENT_REQUESTS=4

# --- Metrics ---
# MAPE ignores half-hours where actual generation is below this value (avoids division by ~0).
MAPE_MIN_ACTUAL_MW=50

# --- Caching ---
CACHE_TTL_SECONDS=3600
# Optional: directory for caching raw Elexon responses of fully historical periods.
# Leave empty to disable. Example: .cache
CACHE_DIR=

# --- CORS (comma-separated). Not needed when the frontend proxies /api. ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
